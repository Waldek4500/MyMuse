<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
             xmlns:models="clr-namespace:MyMuse.Maui.Models"
             x:DataType="models:Song"
             x:Class="MyMuse.Maui.Views.PartialViews.SelectedSongMarker"
             x:Name="This">
    <Border StrokeThickness="4" StrokeShape="{RoundRectangle CornerRadius={Binding Source={x:Reference This}, Path=CornerRadius}}" Stroke="White" IsVisible="{Binding IsSelected, FallbackValue='False'}">
        <Grid>
            <Image Source="equalizer.gif"
                   IsAnimationPlaying="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HeightRequest="{Binding Source={x:Reference This}, Path=PlayingImageHeight}"
                   IsVisible="{Binding IsPlaying}"/>

            <Image Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.MoreHorizontal}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HeightRequest="{Binding Source={x:Reference This}, Path=PauseImageHeight}"
                   IsVisible="{Binding IsPaused}"
                   MaximumWidthRequest="60"/>
        </Grid>
    </Border>
</ContentView>
