<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MyMuse.Maui.ViewModels"
             x:Class="MyMuse.Maui.Views.MiniPlayerBar"
             x:DataType="vm:MusicPlayerViewModel">

    <Grid Padding="10,0,10,10">
        <toolkit:MediaElement
            x:Name="AudioPlayer"
            IsVisible="Collapse"
            Source="{Binding CurrentSong.AudioUrl}"
            MetadataTitle="{Binding CurrentSong.Title}"
            MetadataArtist="{Binding CurrentSong.Band}"
            MetadataArtworkUrl="{Binding CurrentSong.ImageUrl}"
            ShouldAutoPlay="True"
            ShouldShowPlaybackControls="False"
            StateChanged="AudioPlayer_StateChanged"
            PropertyChanged="AudioPlayer_PropertyChanged"
            PositionChanged="AudioPlayer_PositionChanged"
            MediaEnded="AudioPlayer_MediaEnded"
            ShouldLoopPlayback="{Binding ShouldPlayInLoop}"/>

        <Border IsVisible="{Binding HasTrack}"
                Stroke="#25153B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Color="#1A0B2D" Offset="0" />
                    <GradientStop Color="#13111E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToDetailsCommand}" />
            </Border.GestureRecognizers>

            <VerticalStackLayout>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      RowSpacing="5"
                      Padding="10,8,10,10">

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            WidthRequest="50"
                            HeightRequest="50">
                        <Image Grid.Column="0"
                               Source="{Binding CurrentSong.ImageUrl}"
                               Aspect="AspectFill"
                               WidthRequest="50"
                               HeightRequest="50" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding CurrentSong.Title}"
                               Style="{StaticResource Small}"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding CurrentSong.Band}"
                               Style="{StaticResource Micro}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <ImageButton Grid.Column="2"
                                Source="{Binding PlayPauseBtnImage}"
                                BackgroundColor="#A855F7"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="22"
                                Padding="12"
                                Command="{Binding PlayPauseCommand}">
                    </ImageButton>
                </Grid>
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Progress="{Binding PositionProgress}"
                             VerticalOptions="End"
                             HeightRequest="1"
                             ProgressColor="#A855F7"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>