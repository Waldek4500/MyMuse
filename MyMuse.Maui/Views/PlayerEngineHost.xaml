<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:MyMuse.Maui.ViewModels"
             x:DataType="viewmodels:MusicPlayerViewModel"
             x:Class="MyMuse.Maui.Views.PlayerEngineHost"
             HeightRequest="0">
    
    <toolkit:MediaElement
            x:Name="AudioPlayer"
            IsVisible="False"
            Source="{Binding AudioUrl}"
            MetadataTitle="{Binding SongTitle}"
            MetadataArtist="{Binding Artist}"
            MetadataArtworkUrl="{Binding ArtworkUrl}"
            ShouldAutoPlay="False"
            ShouldShowPlaybackControls="False"
            StateChanged="AudioPlayer_StateChanged"
            PropertyChanged="AudioPlayer_PropertyChanged"
            PositionChanged="AudioPlayer_PositionChanged"
            MediaEnded="AudioPlayer_MediaEnded"
            ShouldLoopPlayback="{Binding ShouldPlayInLoop}"/>
</ContentView>
