<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:iconsCodes="clr-namespace:MyMuse.Maui.Resources.Images.Icons"
             xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
             xmlns:viewmodel="clr-namespace:MyMuse.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyMuse.Maui.Pages.SongDetailsPage"
             x:DataType="viewmodel:MusicPlayerViewModel"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title=""
             Shell.PresentationMode="ModalAnimated">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>
    
    <Grid RowDefinitions="Auto, *, Auto" Padding="20,10,20,0">

        <ActivityIndicator IsRunning="{Binding IsBuffering}"
                           IsVisible="{Binding IsBuffering}"
                           Grid.RowSpan="3"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           ZIndex="5"/>

        <!-- Row 0: Header -->
        <Grid ColumnDefinitions="Auto, *, Auto">
            <ImageButton BackgroundColor="#44FFFFFF"
                         CornerRadius="22"
                         HorizontalOptions="Start"
                         WidthRequest="20"
                         HeightRequest="20"
                         Padding="8"
                         Command="{Binding GoBackCommand}"
                         Source="{icons:Icon ArrowDown}"/>



            <Label Grid.Column="1"
                   Style="{StaticResource Small}"
                   FontFamily="Archivo"
                   Text="NOW PLAYING"
                   TextColor="#AAFFFFFF"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"/>

            <ImageButton Grid.Column="2"
                         HorizontalOptions="End"
                         BackgroundColor="#44FFFFFF"
                         CornerRadius="22"
                         WidthRequest="20"
                         HeightRequest="20"
                         Padding="8"
                         Source="{icons:Icon MoreHorizontal}"/>
        </Grid>

        <!-- Row 1: Image -->
        <Border Grid.Row="1" Stroke="Transparent"
                StrokeShape="RoundRectangle 40"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="20">
            <Image Source="{Binding CurrentSong.ImageUrl}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Aspect="AspectFit"/>
        </Border>

        <!-- Row 2: Audio Player -->
        <VerticalStackLayout Grid.Row="2" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,*"
                  Margin="10">
                <VerticalStackLayout>
                    <Label Text="{Binding CurrentSong.Title}"
                           Style="{StaticResource Large}"/>
                    <Label Text="{Binding CurrentSong.Band}"
                           Style="{StaticResource Micro}"/>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End"
                                       Spacing="10">
                    <ImageButton BackgroundColor="#44FFFFFF"
                                 CornerRadius="22"
                                 HeightRequest="20"
                                 WidthRequest="20"
                                 Padding="8"
                                 Source="{icons:Icon AlignLeft}"/>

                    <ImageButton HeightRequest="20"
                                 WidthRequest="20"
                                 Padding="8"
                                 CornerRadius="20"
                                 Source="{icons:Icon Favorite}"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout>
                <Slider ThumbColor="White"
                        MinimumTrackColor="#A855F7"
                        DragStarted="Slider_DragStarted"
                        DragCompleted="Slider_DragCompleted"
                        Value="{Binding PositionSeconds}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"/>
                <Grid ColumnDefinitions="*, *"
                      Margin="10,0">
                    <Label Text="{Binding PositionText}"
                           Style="{StaticResource Micro}"
                           Margin="0" Padding="0"/>
                    <Label Grid.Column="1"
                           HorizontalTextAlignment="End"
                           Text="{Binding DurationText}"
                           Style="{StaticResource Micro}"
                           Margin="0" Padding="0"/>
                </Grid>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,*,*,*,*"
                  Margin="10">
                <ImageButton Source="shuffle_icon.png"
                             CornerRadius="22"
                             Padding="10"
                             Aspect="AspectFit"
                             WidthRequest="20"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"/>
                
                <ImageButton Grid.Column="1"
                             WidthRequest="40"
                             CornerRadius="20"
                             Command="{Binding PreviousSongCommand}"
                             Source="{icons:Icon SkipPrevious}"/>
                
                <ImageButton Grid.Column="2"
                             Source="{Binding PlayPauseBtnImage}"
                             BackgroundColor="#A855F7"
                             WidthRequest="60"
                             HeightRequest="60"
                             CornerRadius="30"
                             Padding="15"
                             Command="{Binding PlayPauseCommand}"/>
                
                <ImageButton Grid.Column="3"
                             WidthRequest="40"
                             CornerRadius="20"
                             Command="{Binding NextSongCommand}"
                             Source="{icons:Icon SkipNext}"/>
                
                <ImageButton Grid.Column="4"
                             CornerRadius="22"
                             Padding="8"
                             Aspect="AspectFit"
                             WidthRequest="20"
                             HeightRequest="20"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Command="{Binding TogglePlayInLoopCommand}">
                    <ImageButton.Source>
                        <FontImageSource Glyph="{Static iconsCodes:MaterialIcons.Autorenew}"
                                         FontFamily="MaterialSymbols"
                                         Color="{Binding PlayInLoopBtnColor}"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>