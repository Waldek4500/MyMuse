<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyMuse.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:MyMuse.Maui.Features.Home"
    xmlns:search="clr-namespace:MyMuse.Maui.Features.Search"
    xmlns:library="clr-namespace:MyMuse.Maui.Features.Library"
    xmlns:about="clr-namespace:MyMuse.Maui.Features.About"
    xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
    Title="My Muse"
    Shell.TabBarTitleColor="#994EE1"
    Shell.TabBarUnselectedColor="#535172"
    Shell.TabBarBackgroundColor="#0B0B18"
    Shell.TabBarForegroundColor="#994EE1">

    <TabBar>
        <Tab Title="Home"
             Icon="{icons:Icon Glyph={x:Static icons:MaterialIcons.Home}}">
            <ShellContent ContentTemplate="{DataTemplate home:MainPage}"/>
        </Tab>

        <Tab Title="Search"
             Icon="{icons:Icon Glyph={x:Static icons:MaterialIcons.Search}}">
            <ShellContent ContentTemplate="{DataTemplate search:SearchPage}"/>
        </Tab>

        <Tab Title="Library"
             Icon="{icons:Icon Glyph={x:Static icons:MaterialIcons.Browse}}">
            <ShellContent ContentTemplate="{DataTemplate library:LibraryPage}"/>
        </Tab>

        <Tab Title="About"
             Icon="{icons:Icon Glyph={x:Static icons:MaterialIcons.Info}}">
            <ShellContent ContentTemplate="{DataTemplate about:AboutPage}"/>
        </Tab>
    </TabBar>

</Shell>
