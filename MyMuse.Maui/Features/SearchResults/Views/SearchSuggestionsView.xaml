<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
             xmlns:models="clr-namespace:MyMuse.Shared.Dtos;assembly=MyMuse.Shared"
             xmlns:searchResults="clr-namespace:MyMuse.Maui.Features.SearchResults"
             x:DataType="searchResults:SearchResultsPageViewModel"
             x:Class="MyMuse.Maui.Features.SearchResults.Views.SearchSuggestionsView">
    <Grid>
        <CollectionView ItemsSource="{Binding FilteredResults}"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResultDto">
                    <Grid ColumnDefinitions="*, Auto"
                          Padding="10"
                          ColumnSpacing="10">

                        <Grid>
                            <Grid ColumnDefinitions="Auto, *"
                                  ColumnSpacing="10">
                                <Border StrokeThickness="0"
                                        StrokeShape="{RoundRectangle CornerRadius={Binding Type, Converter={StaticResource ResultTypeToCornerRadiusConverter}}}"
                                        HeightRequest="60" WidthRequest="60">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFit"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource Medium}"/>
                                    <HorizontalStackLayout Spacing="5">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{Binding Type, Converter={StaticResource ResultTypeToColorConverter}, ConverterParameter='Background'}" Padding="8,4"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Type}"
                                                   FontSize="10"
                                                   TextColor="{Binding Type, Converter={StaticResource ResultTypeToColorConverter}}"
                                                   TextTransform="Uppercase"/>
                                        </Border>
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource MicroViolet}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type searchResults:SearchResultsPageViewModel}}, Path=GoToSelectedCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <ImageButton Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.MoreVert}}"
                                     Grid.Column="2"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End"
                                     CornerRadius="10"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
