<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyMuse.Shared.Dtos;assembly=MyMuse.Shared"
             xmlns:viewmodel="clr-namespace:MyMuse.Maui.Features.Home"
             xmlns:partialViews="clr-namespace:MyMuse.Maui.Views.PartialViews"
             xmlns:views="clr-namespace:MyMuse.Maui.Views"
             xmlns:homeViews="clr-namespace:MyMuse.Maui.Features.Home.Views"
             xmlns:playerBar="clr-namespace:MyMuse.Maui.Features.PlayerBar"
             xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
             x:DataType="viewmodel:MainPageViewModel"
             x:Class="MyMuse.Maui.Features.Home.MainPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="">

    <Grid RowDefinitions="*,Auto" Margin="0" Padding="0">

        <!-- A single MediaElement control for entire application -->
        <ContentView x:Name="PlayerEnginge"/>

        <ActivityIndicator IsVisible="{Binding IsBusy}" 
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           ZIndex="5"/>

        <RefreshView Command="{Binding GetSongsCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="30"
                                     Padding="20,10,20,0">

                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="My Muse"
                               Style="{StaticResource Header}"
                               VerticalOptions="Center"/>

                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="10"
                                               HorizontalOptions="End">
                            <!-- Refresh button for desktop -->
                            <ImageButton HeightRequest="40"
                                         WidthRequest="40"
                                         CornerRadius="22"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                         IsVisible="{OnIdiom Default=False, Desktop=True}"
                                         Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.Refresh}}"
                                         Command="{Binding GetSongsCommand}"/>
                            <Border Grid.Column="1"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Stroke="{StaticResource Purple}"
                                    StrokeShape="RoundRectangle 22"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                <Image Grid.Column="1" 
                                       Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.Person}}"
                                       HeightRequest="{x:OnIdiom Desktop=24, Default=36}"
                                       WidthRequest="{x:OnIdiom Desktop=24, Default=36}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Featured Songs -->
                    <homeViews:FeaturedSongsView/>

                    <!-- Recently played -->
                    <homeViews:RecentlyPlayedView/>

                    <!-- Albums -->
                    <homeViews:AlbumsView/>

                    <!-- Trending -->
                    <homeViews:TrendingSongsView/>

                    <!-- Artists -->
                    <homeViews:ArtistsView/>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        
        <playerBar:PlayerBar Grid.Row="1"/>
    </Grid>
</ContentPage>