<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyMuse.Shared.Dtos;assembly=MyMuse.Shared"
             xmlns:viewmodel="clr-namespace:MyMuse.Maui.Features.Home"
             xmlns:partialViews="clr-namespace:MyMuse.Maui.Views.PartialViews"
             xmlns:views="clr-namespace:MyMuse.Maui.Views"
             xmlns:homeViews="clr-namespace:MyMuse.Maui.Features.Home.Views"
             xmlns:playerBar="clr-namespace:MyMuse.Maui.Features.PlayerBar"
             x:DataType="viewmodel:MainPageViewModel"
             x:Class="MyMuse.Maui.Features.Home.MainPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title=""
             BackgroundColor="{StaticResource BackgroundDark}">

    <Grid RowDefinitions="*,Auto" Margin="0" Padding="0">

        <views:PlayerEngineHost/>

        <ActivityIndicator IsVisible="{Binding IsBusy}" 
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           ZIndex="5"/>

        <RefreshView Command="{Binding GetSongsCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <Grid RowSpacing="25"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                      Padding="20,10,20,0">

                    <!-- Row 0: Header -->
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="Good Evening, Alex."
                           Style="{StaticResource Header}"
                           VerticalOptions="Center"/>

                        <Border Grid.Column="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            Stroke="#a855f7"
                            StrokeShape="RoundRectangle 20"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                            <Image Grid.Column="1" Source="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde"/>
                        </Border>
                    </Grid>

                    <!-- Row 1: Featured Songs -->
                    <homeViews:FeaturedSongsView Grid.Row="1" />

                    <!-- Row 2 -->
                    <homeViews:RecentlyPlayedView Grid.Row="2" />

                    <!-- Row 3: Trending -->
                    <homeViews:TrendingSongsView Grid.Row="3" />

                    <!-- Row 4: Artists -->
                    <homeViews:ArtistsView Grid.Row="4" />
                </Grid>
            </ScrollView>
        </RefreshView>
        
        <playerBar:PlayerBar Grid.Row="1"/>
    </Grid>
</ContentPage>