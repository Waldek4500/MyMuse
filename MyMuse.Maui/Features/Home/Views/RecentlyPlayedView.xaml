<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:partialViews="clr-namespace:MyMuse.Maui.Views.PartialViews"
             xmlns:viewmodel="clr-namespace:MyMuse.Maui.Features.Home"
             xmlns:models="clr-namespace:MyMuse.Maui.Models"
             xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
             x:DataType="viewmodel:MainPageViewModel"
             x:Class="MyMuse.Maui.Features.Home.Views.RecentlyPlayedView">
    <VerticalStackLayout Spacing="5">
        <Grid ColumnDefinitions="*,*">
            <Label Text="More Tracks"
                   Style="{StaticResource Large}"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            <Label Grid.Column="1"
                   Text="See all  >"
                   Style="{StaticResource MicroViolet}"
                   HorizontalOptions="End"
                   VerticalOptions="Center"/>
        </Grid>

        <CollectionView ItemsSource="{Binding RecentSongs}" HorizontalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <VerticalStackLayout>

                        <Grid>
                            <partialViews:ImagePlaceholderView
                                HeightRequest="120"
                                CornerRadius="20"
                                ShowPlaceholder="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MainPageViewModel}}, Path=ShowPlaceHolder[1]}"/>

                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="120">
                                <Image Source="{Binding Data.ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="120"/>
                            </Border>

                            <partialViews:SelectedSongMarker CornerRadius="20" PlayingImageHeight="20" PauseImageHeight="30"/>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding Data}"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MainPageViewModel}}, Path=GoToSongDetailsCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>

                        <VerticalStackLayout Margin="2,5,0,0">
                            <Label Text="{Binding Data.Title}"
                                   Style="{StaticResource Small}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   HorizontalOptions="Start"
                                   MaximumWidthRequest="100"/>
                            <Label Text="{Binding Data.Artist}"
                                   Style="{StaticResource MicroViolet}"
                                   LineBreakMode="TailTruncation"
                                   MaximumWidthRequest="100"
                                   HorizontalOptions="Start"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>