<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:partialViews="clr-namespace:MyMuse.Maui.Views.PartialViews"
             xmlns:viewmodel="clr-namespace:MyMuse.Maui.Features.Home"
             xmlns:models="clr-namespace:MyMuse.Maui.Models"
             x:DataType="viewmodel:MainPageViewModel"
             x:Class="MyMuse.Maui.Features.Home.Views.TrendingSongsView">
    <VerticalStackLayout Grid.Row="3" Spacing="5">
        <Grid ColumnDefinitions="*,*">
            <Label Text="Trending"
                   Style="{StaticResource Large}"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            <Label Grid.Column="1"
                   Text="See all  >"
                   Style="{StaticResource MicroViolet}"
                   HorizontalOptions="End"
                   VerticalOptions="Center"/>
        </Grid>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TrendingSongs}" 
                             Spacing="5">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:Song">
                    <Grid ColumnDefinitions="*, Auto">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Grid>
                                <Border Stroke="Transparent" StrokeShape="RoundRectangle 15">

                                    <Image Source="{Binding Data.ImageUrl}"
                                           WidthRequest="70"
                                           Aspect="AspectFill"/>
                                </Border>

                                <partialViews:SelectedSongMarker CornerRadius="15" PlayingImageHeight="20" PauseImageHeight="30"/>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Data.Title}"
                                       Style="{StaticResource Small}"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Data.Artist}"
                                       Style="{StaticResource MicroViolet}"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding Data}"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MainPageViewModel}}, Path=GoToSongDetailsCommand}"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="{Binding Data.PlaysNumber, StringFormat='{0} Plays'}"
                                   Style="{StaticResource MicroViolet}"/>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>