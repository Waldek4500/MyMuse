<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:MyMuse.Maui.MarkupExtensions"
             xmlns:player="clr-namespace:MyMuse.Maui.Features.Player"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyMuse.Maui.Features.Player.PlayerPage"
             x:DataType="player:PlayerPageViewModel"
             Title=""
             Shell.PresentationMode="ModalAnimated">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,10,20,40">

        <!-- Row 0: Header -->
        <Grid ColumnDefinitions="Auto, *, Auto">
            <ImageButton Style="{StaticResource RoundBtn}"
                         Padding="8"
                         HorizontalOptions="Start"
                         Command="{Binding GoBackCommand}"
                         Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.ArrowDown}}"/>

            <Label Grid.Column="1"
                   Style="{StaticResource Small}"
                   FontFamily="Archivo"
                   Text="NOW PLAYING"
                   TextColor="#AAFFFFFF"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"/>

            <ImageButton Grid.Column="2"
                         HorizontalOptions="End"
                         Style="{StaticResource RoundBtn}"
                         Padding="8"
                         Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.MoreHorizontal}}"/>
        </Grid>

        <!-- Row 1: Image -->
        <Grid Grid.Row="1">
            <Border Stroke="Transparent"
                    StrokeShape="RoundRectangle 40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="20"
                    MaximumHeightRequest="500"
                    MaximumWidthRequest="500">
                <Image Source="{Binding Player.ArtworkUrl}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Aspect="AspectFit"
                       MaximumHeightRequest="500"
                       MaximumWidthRequest="500"/>
            </Border>

            <ActivityIndicator IsRunning="{Binding Player.IsBuffering}"
                               IsVisible="{Binding Player.IsBuffering}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               ZIndex="5"/>
        </Grid>

        <!-- Row 2: Audio Player -->
        <VerticalStackLayout Grid.Row="2">
            <Grid ColumnDefinitions="*,*"
                  Margin="10">
                <VerticalStackLayout>
                    <Label Text="{Binding Player.SongTitle}"
                           Style="{StaticResource Large}"/>
                    <Label Text="{Binding Player.Artist}"
                           Style="{StaticResource Micro}"/>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End"
                                       Spacing="10">
                    <ImageButton Style="{StaticResource RoundBtn}"
                                 Padding="8"
                                 Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.AlignLeft}}"/>

                    <ImageButton HeightRequest="40"
                                 WidthRequest="40"
                                 Padding="8"
                                 CornerRadius="22"
                                 Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.Favorite}}"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout>
                <Slider ThumbColor="White"
                        MinimumTrackColor="{StaticResource Purple}"
                        Value="{Binding Player.PositionSeconds}"
                        Minimum="0"
                        Maximum="{Binding Player.DurationSeconds}"
                        x:Name="Slider"
                        Margin="{OnIdiom Default=0, Desktop='10,0'}">
                    <Slider.Behaviors>
                        <toolkit:EventToCommandBehavior EventName="DragStarted"
                                                        BindingContext="{Binding Source={x:Reference Slider}, Path=BindingContext}"
                                                        Command="{Binding Source={x:Reference Slider}, Path=BindingContext.PauseCommand}"/>
                        <toolkit:EventToCommandBehavior EventName="DragCompleted"
                                                        BindingContext="{Binding Source={x:Reference Slider}, Path=BindingContext}"
                                                        CommandParameter="{Binding Source={x:Reference Slider}, Path=Value}"
                                                        Command="{Binding Source={x:Reference Slider}, Path=BindingContext.SeekToAndResumeCommand}"/>
                    </Slider.Behaviors>
                </Slider>
                <Grid ColumnDefinitions="*, *"
                      Margin="10,0">
                    <Label Text="{Binding Player.PositionText}"
                           Style="{StaticResource Micro}"
                           Margin="0" Padding="0"/>
                    <Label Grid.Column="1"
                           HorizontalTextAlignment="End"
                           Text="{Binding Player.DurationText}"
                           Style="{StaticResource Micro}"
                           Margin="0" Padding="0"/>
                </Grid>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*, Auto, *"
                  Margin="10">
                <ImageButton Source="shuffle.png"
                             CornerRadius="22"
                             Padding="10"
                             WidthRequest="40"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="20">
                    <ImageButton WidthRequest="40"
                                 CornerRadius="20"
                                 Command="{Binding Queue.PreviousSongCommand}"
                                 Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.SkipPrevious}, Size=40}"/>

                    <ImageButton Source="{Binding Player.IsPlaying, Converter={StaticResource IsPlayingConverter}}"
                                 BackgroundColor="#A855F7"
                                 WidthRequest="60"
                                 HeightRequest="60"
                                 CornerRadius="30"
                                 Padding="15"
                                 Command="{Binding Player.PlayPauseCommand}"/>

                    <ImageButton WidthRequest="40"
                                 CornerRadius="20"
                                 Command="{Binding Queue.NextSongCommand}"
                                 Source="{icons:Icon Glyph={x:Static icons:MaterialIcons.SkipNext}, Size=40}"/>
                </HorizontalStackLayout>

                <ImageButton Grid.Column="4"
                             CornerRadius="22"
                             WidthRequest="40"
                             HeightRequest="40"
                             Padding="8"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Command="{Binding Queue.TogglePlayInLoopCommand}">
                    <ImageButton.Source>
                        <FontImageSource Glyph="{Static icons:MaterialIcons.Autorenew}"
                                         FontFamily="MaterialSymbols"
                                         Color="{Binding Player.ShouldPlayInLoop, Converter={StaticResource IsOptionEnabledConverter}}"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>