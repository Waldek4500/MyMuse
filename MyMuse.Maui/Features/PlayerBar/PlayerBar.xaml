<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:playerBar="clr-namespace:MyMuse.Maui.Features.PlayerBar"
             x:Class="MyMuse.Maui.Features.PlayerBar.PlayerBar"
             x:DataType="playerBar:PlayerBarViewModel">

    <Grid Padding="10,0,10,10">
        <Border IsVisible="{Binding Player.HasTrack}"
                Stroke="#25153B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Color="#1A0B2D" Offset="0" />
                    <GradientStop Color="#13111E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToDetailsCommand}" />
            </Border.GestureRecognizers>

            <VerticalStackLayout>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      RowSpacing="5"
                      Padding="10,8,10,10">

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 15"
                            WidthRequest="50"
                            HeightRequest="50">
                        <Image Grid.Column="0"
                               Source="{Binding Player.ArtworkUrl}"
                               Aspect="AspectFill"
                               WidthRequest="50"
                               HeightRequest="50" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding Player.SongTitle}"
                               Style="{StaticResource Small}"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Player.Artist}"
                               Style="{StaticResource Micro}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <ImageButton Grid.Column="2"
                                Source="{Binding Player.IsPlaying, Converter={StaticResource IsPlayingConverter}}"
                                BackgroundColor="#A855F7"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="22"
                                Padding="12"
                                Command="{Binding Player.PlayPauseCommand}">
                    </ImageButton>
                </Grid>
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="3"
                             Progress="{Binding Player.PositionProgress}"
                             VerticalOptions="End"
                             HeightRequest="1"
                             ProgressColor="#A855F7"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>