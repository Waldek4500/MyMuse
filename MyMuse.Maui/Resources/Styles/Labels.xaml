<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label"
           x:Key="Header">
        <Setter Property="FontFamily" Value="Archivo"/>
        <Setter Property="TextColor" Value="#F0EEFF"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label"
           x:Key="Large">
        <Setter Property="FontFamily" Value="Archivo"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label"
           x:Key="Medium">
        <Setter Property="FontFamily" Value="DMSans"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource Medium}"
           x:Key="MediumViolet">
        <Setter Property="TextColor" Value="{StaticResource Violet}"/>
    </Style>

    <Style TargetType="Label"
           x:Key="Small">
        <Setter Property="FontFamily" Value="DMSans"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource Small}"
           x:Key="SmallViolet">
        <Setter Property="TextColor" Value="{StaticResource Violet}"/>
    </Style>

    <Style TargetType="Label"
           x:Key="Micro">
        <Setter Property="FontFamily" Value="DMSans"/>
        <Setter Property="TextColor" Value="LightSlateGray"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource Micro}"
           x:Key="MicroViolet">
        <Setter Property="TextColor" Value="{StaticResource Violet}"/>
    </Style>

</ResourceDictionary>